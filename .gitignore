# Dependencies and build output
node_modules/
dist/
coverage/
# Prisma client, generated by typecheck and build
src/generated/

# Secrets: every .env file except the example, keys, database dumps
.env
.env.*
!.env.example
*.pem
*.key
*.sql
*.dump
# ...but Prisma migrations are code: without them the server starts on an empty database
!prisma/migrations/**/*.sql
# ...and so are the counts the database transfer compares (deploy/export-db.sh, docs/deployment.md)
!deploy/counts.sql

# The client's brief: prices and personal data stay out of git (no trailing slash: a symlink or a file too)
/brief

# Samples of supplier API responses (pnpm run smoke:suppliers): purchase prices
/output/

# Notes and settings of the agent sessions: the repository is public, they name the client and the server
/.claude/
/CLAUDE.local.md

# Logs, local data, OS and editor files
*.log
/tmp/
/data/
.DS_Store
.idea/
.vscode/
