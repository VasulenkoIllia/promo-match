# Copy to .env and fill in. .env is never committed; keep it private (chmod 600 on the server).
TZ=Europe/Kyiv
LOG_LEVEL=info
PORT=3000

# Production behind Traefik (docker-compose.yml)
APP_NAME=promo-match
APP_DOMAIN=app.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf
# Memory caps of the containers on the shared server; empty means 1g for the app, 2g for the jobs and for the database
APP_MEM_LIMIT=
WORKER_MEM_LIMIT=
DB_MEM_LIMIT=

# Postgres for docker-compose.yml and docker-compose.dev.yml. Password: letters and digits only (it goes into a URL),
# e.g. from `openssl rand -hex 24`
POSTGRES_DB=promo_match
POSTGRES_USER=promo_match
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Local development only: <POSTGRES_PASSWORD> is the same password as above, the port is POSTGRES_PORT.
# In Docker the app gets DATABASE_URL from docker-compose.yml.
DATABASE_URL=postgresql://promo_match:<POSTGRES_PASSWORD>@127.0.0.1:5432/promo_match

# Supplier APIs, read only (pnpm run smoke:suppliers, pnpm run import:catalog). These accounts can place real orders:
# .env only. WORKER (a one-off job instead of the HTTP app) is never set here: the import command sets it.
# Macma and Easy Gifts: the https addresses of their XML feeds on the client's shop (docs/integrations.md, «Macma і
# Easy Gifts»). Here and not in the code: the repository is public, and the addresses name the client.
MACMA_FEED_URL=
EASYGIFTS_FEED_URL=
# Axpol B2B API: login and password of the B2B account and its API key
AXPOL_LOGIN=
AXPOL_PASSWORD=
AXPOL_API_KEY=
# Midocean REST API: the x-Gateway-APIKey value
MIDOCEAN_API_KEY=
# Makito API B2B: clientId and clientSecret issued by Makito (POST /access/auth/login)
MAKITO_CLIENT_ID=
MAKITO_CLIENT_SECRET=
# Inspirion LEO API: the X-Gateway-API-Key value
INSPIRION_API_KEY=
# Blue Collection (Asgard) API: username and password of the API account from the account manager (POST /api/token/)
BLUECOLLECTION_USERNAME=
BLUECOLLECTION_PASSWORD=
# Anda Present XML feeds: the token from the account page «API services» (one for all feeds, it is part of the URL).
# The feeds answer only from IP addresses that Anda Present whitelisted.
ANDA_FEED_TOKEN=

# Embeddings (pnpm run embed:catalog, pnpm run embed:compare; docs/integrations.md, «Модель ембедінгів»). Paid calls:
# a run stops before a call that would take its spending past EMBED_BUDGET_USD (USD at list prices, per run).
# EMBED_PROVIDER: voyage or gemini; a dry run without it prices both.
EMBED_PROVIDER=
EMBED_BUDGET_USD=
# Voyage AI (MongoDB): a model API key from MongoDB Atlas, AI Model APIs. A key of the old Voyage platform needs
# VOYAGE_API_URL=https://api.voyageai.com/v1; empty means https://ai.mongodb.com/v1.
VOYAGE_API_KEY=
VOYAGE_API_URL=
# Google Gemini API, paid tier (the free tier uses the data to improve Google's products)
GEMINI_API_KEY=

# Search (POST /api/search, pnpm run search; docs/integrations.md, «Пошук»): the query is embedded by the model's
# provider with its key above. Spending limit of the search in USD at list prices per calendar day of the process;
# empty means 1.
SEARCH_BUDGET_USD=
# A user's paid searches per minute, on top of the daily limits; empty means 20. Past it the answer is 429.
SEARCH_RATE_PER_MINUTE=
# Claude reads the text of a search first: translated into English, filters suggested (docs/integrations.md,
# «Claude API»). Without the key the search embeds the text as it is. QUERY_PARSE_MODEL: claude-haiku-5-5 (empty),
# claude-sonnet-5-5 or claude-opus-5-5. QUERY_PARSE_BUDGET_USD: USD at list prices per calendar day; empty means 1.
# The key only: other ANTHROPIC_* variables (a base URL, custom headers) are not set here.
ANTHROPIC_API_KEY=
QUERY_PARSE_MODEL=
QUERY_PARSE_BUDGET_USD=
