{
  "name": "promo-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "smoke:suppliers": "node --env-file-if-exists=.env --import tsx scripts/smoke-test.ts",
    "import:catalog": "WORKER=import node --env-file-if-exists=.env --import tsx src/main.ts",
    "embed:catalog": "WORKER=embed node --env-file-if-exists=.env --import tsx src/main.ts",
    "embed:compare": "node --env-file-if-exists=.env --import tsx scripts/compare-embeddings.ts",
    "embed:brand-free": "node --env-file-if-exists=.env --import tsx scripts/embed-brand-free.ts",
    "categories:sync": "WORKER=categories node --env-file-if-exists=.env --import tsx src/main.ts",
    "search": "node --env-file-if-exists=.env --import tsx scripts/search.ts",
    "search:quality": "node --env-file-if-exists=.env --import tsx scripts/quality-test.ts",
    "search:independent": "node --env-file-if-exists=.env --import tsx scripts/independent-test.ts",
    "search:independent:sample": "node --env-file-if-exists=.env --import tsx scripts/independent-sample.ts",
    "users": "WORKER=users node --env-file-if-exists=.env --import tsx src/main.ts",
    "db:generate": "prisma generate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "prisma generate && prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/static": "10.1.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
